{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "minibot",
  "version": "1.4.5",
  "identifier": "com.minibot.app",
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://localhost:7009",
    "beforeDevCommand": "",
    "beforeBuildCommand": "npm --prefix frontend run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MiniBot",
        "url": "index.html",
        "width": 1360,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
